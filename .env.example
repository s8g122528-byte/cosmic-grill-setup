# ==============================================================================
# Kennedy Moon Grill — Frontend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to `.env` or set these in Lovable / Vercel / Railway Project Settings.
# All client-side variables MUST start with `VITE_`.
# ==============================================================================

# ── 1. Backend API Configuration (Required for live backend) ─────────────────
# When running locally: http://127.0.0.1:8000/api
# When using ngrok tunnel: https://<your-subdomain>.ngrok-free.app/api
# When deployed to cloud: https://api.yourrestaurant.com/api
# (Note: trailing '/api' or trailing slashes are automatically handled)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# ── 2. Real-Time WebSocket Configuration (Optional - Auto-Derived) ───────────
# If left unset, the app automatically derives WebSocket URL from VITE_API_BASE_URL
# (http:// -> ws://, https:// -> wss://).
# Set these ONLY if your WebSocket runs on a different port, domain, or reverse-proxy path:
# VITE_WS_BASE_URL=ws://127.0.0.1:8000
# VITE_WS_HOST=127.0.0.1:8000

# ── 3. Tenant & Restaurant Scoping ───────────────────────────────────────────
# The active restaurant tenant slug for multi-tenant isolation.
# Default tenant for this deployment:
VITE_DEFAULT_TENANT_SLUG=moon-grill-narowal

# Default branch ID for multi-branch orders (optional):
# VITE_DEFAULT_BRANCH_ID=1

# ── 4. Authentication Mode ───────────────────────────────────────────────────
# Options: 'jwt' (recommended for mobile/web apps) or 'session' (Django session cookies)
VITE_API_AUTH_MODE=jwt

# ── 5. Standalone / Demo Mode Safety Flag ────────────────────────────────────
# Set to 'false' for live database & production builds.
# Set to 'true' ONLY if you want to preview UI / animations in Lovable without a backend running.
VITE_ALLOW_DEMO=false

# ── 6. Public Domain / App URL ───────────────────────────────────────────────
# Used for generating receipt tracking links and shareable QR links:
VITE_APP_URL=http://localhost:8082

# ── 7. Augmented Reality (AR) Recipe Viewer (Optional) ───────────────────────
# VITE_AR_VIEW_URL=https://view.quicklook.apple.com/...

# ── 8. Voice Assistant / AI Transcription (Server-Side in Lovable / Vinxi) ───
# Required only if using Urdu AI voice ordering features:
# LOVABLE_API_KEY=your_lovable_api_key_here
# LOVABLE_AI_GATEWAY=https://ai.gateway.lovable.dev/v1
